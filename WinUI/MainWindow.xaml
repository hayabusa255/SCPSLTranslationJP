<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SCPSL.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SCP: SL 日本語化インストーラー"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
      <NavigationView x:Name="Nav"
                      PaneDisplayMode="Left"
                      IsPaneOpen="True"
                      OpenPaneLength="286"
                      CompactPaneLength="52"
                      IsPaneToggleButtonVisible="False"
                      IsBackButtonVisible="Collapsed"
                      IsSettingsVisible="False"
                      SelectionChanged="OnNavigationChanged">
        <NavigationView.PaneHeader>
          <StackPanel Margin="6,18,8,20" Spacing="10">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Ellipse Width="62" Height="62">
                <Ellipse.Fill><ImageBrush ImageSource="Assets/researcher.jpg" Stretch="UniformToFill"/></Ellipse.Fill>
              </Ellipse>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="SCP Foundation" FontWeight="SemiBold" FontSize="13"/>
                  <BitmapIcon UriSource="Assets/scp-emblem.png" ShowAsMonochrome="True" Width="16" Height="16"/>
                </StackPanel>
                <TextBlock Text="researcher@scp-foundation.jp" FontSize="10"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <FontIcon Glyph="&#xE80F;" FontSize="13"/>
              <TextBlock Text="組織によって管理されています" FontSize="11"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
          <NavigationViewItem x:Name="NavUpdate" Tag="Update" Content="日本語訳アップデート">
            <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem x:Name="NavHistory" Tag="History" Content="更新履歴">
            <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem x:Name="NavFolders" Tag="Folders" Content="インストール先">
            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem x:Name="NavAbout" Tag="About" Content="このアプリについて">
            <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon>
          </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.Content>
          <Grid>
            <ScrollViewer x:Name="UpdatePage">
              <StackPanel Padding="36,30,32,60" Spacing="22">
                <TextBlock Text="日本語訳アップデート" Style="{StaticResource TitleTextBlockStyle}"/>
                <Grid ColumnSpacing="20" MinHeight="120">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="64"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <TextBlock x:Name="StatusTitle" Text="更新プログラムを確認しています"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="StatusDescription"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="GitHub Releasesから更新情報を取得しています"
                               FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LastChecked" Text="最終チェック: 未実施"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                    <HyperlinkButton x:Name="LatestDetailsButton"
                                     Content="この更新プログラムの内容を見る"
                                     Padding="0" HorizontalAlignment="Left"
                                     Visibility="Collapsed" Click="LatestDetails_Click"/>
                  </StackPanel>
                  <Button x:Name="RefreshButton" Grid.Column="2" Content="更新プログラムのチェック"
                          Style="{StaticResource AccentButtonStyle}"
                          VerticalAlignment="Center" Click="Refresh_Click"/>
                </Grid>

                <StackPanel x:Name="EcoRow" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Visibility="Collapsed">
                  <FontIcon Glyph="&#xE8BE;" FontFamily="Segoe Fluent Icons" FontSize="15"
                            Foreground="ForestGreen" VerticalAlignment="Center" />
                  <TextBlock Text="SCPSL 日本語化インストーラーは二酸化炭素排出量の削減に取り組んでいます"
                             FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  <HyperlinkButton Content="詳細情報" Click="EcoDetails_Click"
                                   Padding="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="AvailableUpdate" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                  <StackPanel Spacing="0">
                    <TextBlock Text="利用可能な更新プログラム" FontWeight="SemiBold"
                               Padding="18,18,18,15" FontSize="15"/>
                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                      <Grid Padding="18" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" FontSize="24" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                          <TextBlock x:Name="AvailableTitle" Text="SCP: SL 日本語翻訳"
                                     FontWeight="SemiBold"/>
                          <HyperlinkButton Content="更新内容を見る" Padding="0"
                                           HorizontalAlignment="Left" Click="LatestDetails_Click"/>
                        </StackPanel>
                        <Button x:Name="InstallButton" Grid.Column="2"
                                Content="ダウンロードしてインストール"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Install_Click" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <StackPanel x:Name="InstallProgress" Visibility="Collapsed" Spacing="8">
                  <TextBlock x:Name="ProgressStage" Text="準備中"/>
                  <ProgressBar x:Name="ProgressValue" Minimum="0" Maximum="100" Value="0" Height="4"/>
                  <TextBlock x:Name="ProgressDetail"
                             Text="翻訳ファイルを処理しています"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Text="その他のオプション"
                           Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,15,0,0"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                  <Button Click="NavigateToFolders_Click" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Background="Transparent"
                          BorderThickness="0" Padding="16,15">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                      </Grid.ColumnDefinitions>
                      <FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="インストール先" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GameFolderText"
                                   Text="Steamのゲームフォルダーを検出しています..."
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                      <FontIcon Grid.Column="2" Glyph="&#xE76C;" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </Border>
                <TextBlock x:Name="InstalledText" Text="インストール済み: 確認中"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed">
              <StackPanel Padding="36,30,32,60" Spacing="16">
                <TextBlock Text="更新履歴" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="GitHub Releasesに公開された更新内容を表示します"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="HistoryStatus" Text="取得しています..."
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="再取得" Click="HistoryRefresh_Click"/>
                </Grid>
                <StackPanel x:Name="HistoryItems" Spacing="8"/>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed">
              <StackPanel Padding="36,30,32,60" Spacing="16">
                <TextBlock Text="インストール先" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="SCP: Secret Laboratoryの保存先を選択してください"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="検出されたゲーム" FontWeight="SemiBold" Padding="18,18,18,10"/>
                    <ListView x:Name="FolderList" SelectionMode="Single"
                              SelectionChanged="FolderList_SelectionChanged"
                              MinHeight="64" MaxHeight="350"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="14" Spacing="10">
                      <Button Content="再スキャン" Click="Rescan_Click"/>
                      <Button Content="フォルダーを参照..." Click="Browse_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
              <StackPanel Padding="36,30,32,60" Spacing="20">
                <TextBlock Text="このアプリについて" Style="{StaticResource TitleTextBlockStyle}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24">
                  <StackPanel Spacing="16">
                    <TextBlock Text="SCPSL 日本語化インストーラー"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Steamのゲームを検出し、翻訳プロジェクトのGitHub Releasesから日本語訳を取得します"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <HyperlinkButton Content="GitHubリポジトリを開く"
                                     HorizontalAlignment="Left" Padding="0"
                                     Click="ProjectLink_Click"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <InfoBar x:Name="ErrorBar" Severity="Error"
                     IsOpen="False" IsClosable="True"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Bottom" Margin="20"/>
          </Grid>
        </NavigationView.Content>
      </NavigationView>
    </Grid>
</Window>